  "typography": {
    "display_lg": { "family": "Inter", "weight": 800, "size": 72, "lineHeight": 1.08 },
    "display_md": { "family": "Inter", "weight": 700, "size": 54, "lineHeight": 1.12 },
    "display_sm": { "family": "Inter", "weight": 700, "size": 40, "lineHeight": 1.18 },
    "heading_lg": { "family": "Inter", "weight": 600, "size": 32, "lineHeight": 1.28 },
